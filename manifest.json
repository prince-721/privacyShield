{
  "manifest_version": 3,
  "name": "BlurShield — Blur Chats, Docs & Code",
  "version": "1.0.0",
  "description": "Automatically blurs sensitive on-screen content (chats, AI prompts, code, documents, images) and reveals it only on hover, click, or a key you choose. Everything runs locally — no servers, no data collection.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "scripts": ["background/service-worker.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "blurshield@privacy.extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "is_exempt": true,
        "required": ["none"],
        "reason": "This extension does not collect any user data. All processing is performed locally on the device."
      }
    }
  },
  "options_page": "options/options.html",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "utils/dom-utils.js",
        "storage/schema.js",
        "utils/stats.js",
        "content/detectors/semantic-detector.js",
        "content/detectors/heuristic-detector.js",
        "content/detectors/media-detector.js",
        "content/sites/site-profiles.js",
        "content/engine/detection-engine.js",
        "content/engine/blur-engine.js",
        "content/engine/reveal-controller.js",
        "content/engine/observer-manager.js",
        "content/engine/panic-controller.js",
        "content/index.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "panic-toggle": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "MacCtrl+Shift+H"
      },
      "description": "Instantly blur or restore the entire page (Panic Button)"
    },
    "cycle-blur-level": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "MacCtrl+Shift+B"
      },
      "description": "Cycle blur intensity (Light → Medium → Strong → Extreme)"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "102"
}
